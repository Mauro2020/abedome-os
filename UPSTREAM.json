{
  "schema_version": 1,
  "product": "ABEDOME OS",
  "upstream": "home-assistant/operating-system",
  "upstream_default_branch": "dev",
  "baseline_release": "17.3",
  "product_branch": "abedome/develop",
  "strategy": "weekly-release-draft-pull-request",
  "approval_required": true,
  "auto_merge": false,
  "first_validation_target": {
    "platform": "ova",
    "architecture": "x86_64",
    "hypervisor": "proxmox-ve",
    "artifact_format": "qcow2"
  }
}
